# Celestia — Variables de entorno
# Copia este archivo a .env y rellena las claves reales.
# Nunca commitees .env (está en .gitignore).

# ─── LLM principal (obligatorio) ───────────────────────────────────────
# Obtené tu key gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Modelo principal — el más potente disponible en Groq free tier
GROQ_MODEL=llama-3.3-70b-versatile
# Modelo secundario — cupo independiente, se usa cuando el principal da 429
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# ─── Fallback LLM (opcional, recomendado) ──────────────────────────────
# Obtené tu key gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# ─── Notificaciones push (opcional) ────────────────────────────────────
# Solo si querés recibir notificaciones via Pushbullet (no es la ruta principal)
# Obtené tu token en https://www.pushbullet.com/#settings
PUSHBULLET_TOKEN=

# ─── Auth simple para los endpoints HTTP (opcional pero recomendado) ───
# Si lo defines, las apps que llamen a /mensaje, /audio, /captura deben
# mandar header "X-Celestia-Token: <valor>". El bridge.js lo lee del mismo .env.
CELESTIA_API_TOKEN=

# ─── Quién puede hablarle por los canales de fuera ──────────────────────
# WhatsApp, Telegram y Discord los puede escribir cualquiera que dé con el bot,
# y al otro lado está tu memoria y lo que Celestia sabe hacer. Por eso: **sin
# lista, el canal no atiende a nadie**. Separa varios con comas.
#
# El identificador es el número (WhatsApp), el chat id (Telegram) o el user id
# (Discord). Si no lo sabes, escríbele una vez: el log te deja la línea exacta
# lista para pegar aquí.
#
# WhatsApp funciona sin tocar esto: usa el número de whatsapp_bridge/numero.txt.
CELESTIA_PERMITIDOS_WHATSAPP=
CELESTIA_PERMITIDOS_TELEGRAM=
CELESTIA_PERMITIDOS_DISCORD=

# ─── Observabilidad: Sentry (opcional) ──────────────────────────────────
# Si lo defines, los errores no controlados se reportan a Sentry con request_id
# como tag. Útil para producción remota.  Crear DSN en sentry.io (free tier OK)
SENTRY_DSN=
SENTRY_ENV=production

# ─── DeepSeek (DE PAGO, opcional) ───────────────────────────────────────
# El único proveedor de pago: platform.deepseek.com. El tope mensual se reparte
# por días para que dure el mes entero; sin cupo hoy, sigue con los gratis.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TOPE_MES=20
